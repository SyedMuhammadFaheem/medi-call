{
  "name": "medi-call",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Twice-daily automated phone-call medication reminders for one person who doesn't use a smartphone. Twilio + SQLite, no LLM.",
  "license": "MIT",
  "keywords": [
    "medication-reminder",
    "twilio",
    "voice",
    "phone-call",
    "reminders",
    "elder-care",
    "sqlite",
    "typescript"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SyedMuhammadFaheem/medi-call.git"
  },
  "bugs": {
    "url": "https://github.com/SyedMuhammadFaheem/medi-call/issues"
  },
  "homepage": "https://github.com/SyedMuhammadFaheem/medi-call#readme",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "start": "node src/index.ts",
    "dev": "node --watch src/index.ts",
    "test": "node --test 'tests/**/*.test.ts'",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "better-sqlite3": "^13.0.3",
    "dotenv": "^16.4.5",
    "express": "^4.21.2",
    "node-cron": "^4.6.0",
    "twilio": "^6.1.1"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.2",
    "@types/node-cron": "^3.0.11",
    "typescript": "^5.7.2"
  }
}
