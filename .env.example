# Copy to .env and fill in. Never commit .env.

# --- Required ---
# The person's normal phone number, E.164 format.
PATIENT_PHONE_NUMBER=+15555550100
# Public HTTPS URL Twilio can reach (your domain, or an ngrok URL in development).
PUBLIC_BASE_URL=https://your-public-domain-or-ngrok-url
# Password for the /admin UI (HTTP Basic Auth, username "admin"). Use a long random value.
ADMIN_PASSWORD=change-me

TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# A Twilio number you own (E.164).
TWILIO_FROM_NUMBER=+15555550101

# --- Optional (defaults shown) ---
PORT=3000
# IANA timezone name; reminder times below are interpreted in this zone.
TIMEZONE=Asia/Karachi
MORNING_REMINDER_TIME=08:00
EVENING_REMINDER_TIME=20:00
DB_PATH=./data/medi-call.db
TTS_VOICE=Polly.Kajal-Neural
TTS_LANGUAGE=hi-IN
